{
  "name": "@freepeak/dsh-mux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./remote": "./lib/remote.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "author": "Linh Doan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FreePeak/dsh-mux.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent",
    "mux",
    "cli",
    "threads",
    "cordis"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/remote.ts --format esm --out-dir lib",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.4.0",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true }
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
