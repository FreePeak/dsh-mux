#!/bin/sh
# TEST FIXTURE standing in for the `claude` CLI.
#
# Validates the mux pipeline inside the container: stdin prompt, non-interactive
# flags, exit 0, and a parseable session id — then proves the resume turn by
# echoing back the --resume id. It never talks to a model. Swap for the real
# `@anthropic-ai/claude-code` for production use.
resume_id=""
while [ $# -gt 0 ]; do
  case "$1" in
    --resume) resume_id="$2"; shift 2 ;;
    *) shift ;;
  esac
done
prompt=$(cat)
# Multi-line stream-json shaped like real Claude Code: system/init noise,
# an assistant text frame, then a final result envelope carrying the answer.
if [ -n "$resume_id" ]; then
  sid="$resume_id"
  answer="fixture claude resumed session ${resume_id}"
else
  sid="sess_fixture_$(date +%s)"
  answer="fixture claude received: ${prompt}"
fi
printf '%s\n' "{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"${sid}\"}"
printf '%s\n' "{\"type\":\"assistant\",\"message\":{\"content\":[{\"type\":\"text\",\"text\":\"${answer}\"}]},\"session_id\":\"${sid}\"}"
printf '%s\n' "{\"type\":\"result\",\"subtype\":\"success\",\"result\":\"${answer}\",\"session_id\":\"${sid}\",\"is_error\":false}"
